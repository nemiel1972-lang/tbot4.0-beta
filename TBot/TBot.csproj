<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Authors>TBot</Authors>
    <Version>4.0.0.0</Version>
    <StartupObject>Tbot.Program</StartupObject>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Copyright>2026 © TBot</Copyright>
    <PackageLicenseExpression>https://licenses.nuget.org/MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.ogame-tbot.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ogame-tbot/TBot</RepositoryUrl>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <Description>OGame Bot</Description>
    <SignAssembly>False</SignAssembly>
    <AssemblyOriginatorKeyFile>ELK-Lab.pfx</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <RootNamespace>Tbot</RootNamespace>
    <PackageReleaseNotes></PackageReleaseNotes>
    <Configurations>Debug;Release</Configurations>
    <ApplicationIcon>tbot.ico</ApplicationIcon>
    <PackageIcon></PackageIcon>
    <!-- Harmlose Warnungen ausblenden (Nachrichten bleiben bei Fehlern sichtbar) -->
    <NoWarn>$(NoWarn);VSTHRD200;VSTHRD100;VSTHRD103;VSTHRD105;VSTHRD002;NETSDK1188;CS0108;CS0219;CS1998;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="tbot.ico" />
    <None Include="..\config\config.vorlage.json" Link="config.vorlage.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\config\lang\*.json" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
	<PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.8" />
	<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Telegram.Bot" Version="22.6.2" />
    <PackageReference Include="Telegram.Bot.Extensions.Polling" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- PATCH 21: instance_settings.json and settings.json used to be copied to the output
       directory on every build/publish (CopyToOutputDirectory=Always). Since the output
       directory IS the live production folder (/home/tbot/tbot), this silently overwrote the
       real, in-use configs (Telegram bot token, account credentials, Exclude lists, ...) with
       the repo's placeholder templates on every single deploy. Both files are removed from the
       build entirely - they are runtime data, not build output, and must be managed and backed
       up manually in /home/tbot/tbot/ instead. -->

  <ItemGroup>
    <None Update="profiles\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TBot.Ogame.Infrastructure\TBot.Ogame.Infrastructure.csproj" />
    <ProjectReference Include="..\TBot.WebUI\TBot.WebUI.csproj" />
  </ItemGroup>

</Project>