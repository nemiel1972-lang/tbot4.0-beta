@model TBot.WebUI.Models.ConfigPageModel
@section Styles {
    <link rel="stylesheet" href="~/css/tbot-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/config-forms.css" asp-append-version="true" />
}

<div class="cfg-page">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="cfg-card cfg-error">Config could not be read: @Model.Error</div>
    }
    else
    {
        <div class="cfg-grid">
            <aside class="cfg-card cfg-side">
                <form method="get" class="cfg-instance" style="@(Model.Instances.Count <= 1 ? "display:none" : null)">
                    <input type="hidden" name="block" value="@Model.Selected" />
                    <select name="instance" onchange="this.form.submit()">
                        @foreach (var alias in Model.Instances)
                        {
                            <option value="@alias" selected="@(alias == Model.Instance)">@alias</option>
                        }
                    </select>
                </form>
                <div class="cfg-search"><input type="search" id="cfg-search" placeholder="Search blocks…" /></div>
                <ul class="cfg-blocks" id="cfg-blocks">
                    @foreach (var b in Model.Blocks)
                    {
                        var cls = "cfg-block" + (b.Name == Model.Selected ? " sel" : "") + " mode-" + b.Mode;
                        <li class="@cls" data-name="@b.Name">
                            <a asp-action="Index" asp-route-instance="@Model.Instance" asp-route-block="@b.Name">
                                <span class="nm">@(string.IsNullOrEmpty(b.Label) ? b.Name : b.Label)</span>
                                @if (b.Mode == "secret") { <span class="lock" title="Credentials: edit the config file directly">🔒</span> }
                                else if (b.Mode == "placeholder") { <span class="ph" title="Placeholder - enable in settings.json">soon</span> }
                                @if (b.Overridden) {
                                    if (!string.IsNullOrEmpty(b.OverrideTag)) { <span class="ovr-tag" title="@b.OverrideText">@b.OverrideTag</span> }
                                    <span class="sw ovr" data-block="@b.Name" title="@b.OverrideText"></span>
                                }
                                else if (b.Active.HasValue) {
                                    var fixedSw = b.Name == "SleepMode" || b.Name == "GhostSleep" || b.Name == "Messenger" || b.Mode == "secret";
                                    <span class="sw @(b.Active.Value ? "on" : "") @(fixedSw ? "" : "click")" data-block="@b.Name" title="@(fixedSw ? "Use the switch on the page" : "Click to switch on/off")"></span>
                                }
                            </a>
                        </li>
                    }
                </ul>
                <div class="cfg-hint">All blocks have their own form. Credentials (login, passwords, own alliance ID, captcha key, proxy login) are not shown or editable here - set them directly in the config file. Every block also has a JSON tab.</div>
            </aside>
            <main class="cfg-card cfg-main" id="cfg-main" data-instance="@Model.Instance" data-block="@Model.Selected" data-mode="@Model.SelectedMode" data-lang="@Model.Language" data-setlang="@Url.Action("SetLanguage", "Config")"
                  data-get="@Url.Action("GetBlock", "Config")" data-lf="@Url.Action("LfSnapshot", "Config")" data-aflosses="@Url.Action("AfLosses", "Config")" data-allynames="@Url.Action("AllyNames", "Config")" data-boosterstock="@Url.Action("BoosterStock", "Config")" data-lfimg="@Url.Content("~/img/lf/")" data-save="@Url.Action("SaveBlock", "Config")" data-setactive="@Url.Action("SetActive", "Config")">
                @if (Model.SelectedMode == "start")
                {
                    <div id="cfg-start" data-url="@Url.Action("StartData", "Config")" data-lf="@Url.Action("Index", "Config")" data-upd="@Url.Action("Check", "Update")" data-updstart="@Url.Action("Start", "Update")" data-upddismiss="@Url.Action("Dismiss", "Update")"><div class="cfg-loading">Loading…</div></div>
                }
                else if (Model.SelectedMode == "placeholder")
                {
                    <div class="cfg-placeholder">
                        <h1>@Model.Selected</h1>
                        <p>The form view for this block is a placeholder and not enabled yet.</p>
                        <p>Enable it in <code>settings.json</code>:</p>
                        <pre>"WebUI": { "FormPages": ["@Model.Selected"] }</pre>
                        <p>Until then, edit the file directly on the server.</p>
                    </div>
                }
                else if (Model.SelectedMode == "secret")
                {
                    <div class="cfg-placeholder">
                        <h1>@Model.Selected</h1>
                        <p>🔒 This block contains credentials (login, password, user name). It is neither shown nor editable in the web UI - change it only directly in the config file (<code>secrets/credentials.json</code>) on the server.</p>
                    </div>
                }
                else
                {
                    <div id="cfg-root"><div class="cfg-loading">Loading…</div></div>
                }
            </main>
        </div>
        <script src="~/js/config-help-en.js" asp-append-version="true"></script>
        <script src="~/js/config-forms.js" asp-append-version="true"></script>
        @if (Model.SelectedMode == "start")
        {
            <script src="~/js/config-start.js" asp-append-version="true"></script>
        }
    }
</div>
