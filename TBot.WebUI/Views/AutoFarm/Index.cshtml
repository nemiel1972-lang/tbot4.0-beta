@using System.Text.Json
@using System.Text.Encodings.Web
@using System.Text.Json.Serialization
@model TBot.WebUI.Models.AutoFarmDashboardModel

@{
    var jsonOptions = new JsonSerializerOptions {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Encoder = JavaScriptEncoder.Default
    };
    var initialSnapshot = JsonSerializer.Serialize(Model, jsonOptions);
}

@section Styles {
    <link rel="stylesheet" href="~/css/autofarm.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tbot-theme.css" asp-append-version="true" />
}

<div class="autofarm-page tbot-dark" id="autofarm-dashboard" data-instance="@Model.SelectedInstance">
    <div class="autofarm-shell">
        <header class="autofarm-header">
            <div>
                <h1>AutoFarm</h1>
                <p class="intro">Diagnostics for scans, decisions and fleets sent by AutoFarm, plus blacklist and database maintenance.</p>
            </div>
            <form method="get" class="instance-picker" style="@(Model.Instances.Count <= 1 ? "display:none" : null)">
                <label for="instance">Instance</label>
                <div class="instance-controls">
                    <select id="instance" name="instance">
                        @foreach (var instance in Model.Instances)
                        {
                            if (string.Equals(instance, Model.SelectedInstance, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@instance" selected>@instance</option>
                            }
                            else
                            {
                                <option value="@instance">@instance</option>
                            }
                        }
                    </select>
                    <button type="submit" class="refresh-button">Open</button>
                </div>
            </form>
        </header>

        @if (ViewBag.FastFarmAvailable == true && ViewBag.FastFarmActive == true)
        {
            <div class="notice notice-warn">
                <strong>FastFarm mode is on.</strong>
                You are looking at the AutoFarm report; the other workers are off while FastFarm runs.
                <a class="plain-button" href="@Url.Action("Index", "AutoFarm", new { instance = Model.SelectedInstance })">Open the FastFarm overview</a>
            </div>
        }
        else if (ViewBag.FastFarmAvailable == true)
        {
            <div class="notice" id="fastfarm-switch-box">
                <strong>FastFarm mode is off.</strong>
                When it is on, this menu entry shows the FastFarm overview instead of this report, and all other workers except the Defender stop.
                <button type="button" class="plain-button" id="fastfarm-switch">Switch FastFarm on</button>
            </div>
            <script>
                document.getElementById("fastfarm-switch").addEventListener("click", async (ev) => {
                    if (!window.confirm("Switch FastFarm ON? All other workers except the Defender stop.\nIt is saved right away and takes effect when the bot re-reads the config.")) return;
                    const button = ev.currentTarget;
                    button.disabled = true;
                    try {
                        const body = new URLSearchParams({ instance: document.getElementById("autofarm-dashboard").dataset.instance, block: "FastFarm", active: "true" });
                        const r = await (await fetch('@Url.Action("SetActive", "Config")', { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() })).json();
                        if (!r.success) { alert("Could not switch: " + r.error); button.disabled = false; return; }
                        window.location.reload();
                    } catch (e) { alert("Could not switch: " + e); button.disabled = false; }
                });
            </script>
        }
        else if (ViewBag.FastFarmCompiled == true)
        {
            <div class="notice" id="fastfarm-create-box">
                <strong>FastFarm is built in, but your config has no FastFarm block yet.</strong>
                <button type="button" class="plain-button" id="fastfarm-create">Add FastFarm block (switched off)</button>
            </div>
            <script>
                document.getElementById("fastfarm-create").addEventListener("click", async (ev) => {
                    const button = ev.currentTarget;
                    button.disabled = true;
                    try {
                        const body = new URLSearchParams({ instance: document.getElementById("autofarm-dashboard").dataset.instance });
                        const r = await (await fetch('@Url.Action("CreateFastFarm", "Config")', { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body.toString() })).json();
                        if (!r.success) { alert("Could not add the block: " + r.error); button.disabled = false; return; }
                        window.location.reload();
                    } catch (e) { alert("Could not add the block: " + e); button.disabled = false; }
                });
            </script>
        }

        <div class="dashboard-toolbar" role="status" aria-live="polite">
            <span id="poll-status">Loading current data...</span>
            <span id="last-updated"></span>
            <label class="mask-toggle"><input type="checkbox" id="af-mask" /> Hide data</label>
            <button type="button" class="plain-button" id="copy-logs">Copy logs</button>
        </div>

        <div id="dashboard-notice"></div>
        <div id="dashboard-content"></div>
    </div>
</div>

<script>
    (() => {
        const root = document.getElementById("autofarm-dashboard");
        const content = document.getElementById("dashboard-content");
        const notice = document.getElementById("dashboard-notice");
        const pollStatus = document.getElementById("poll-status");
        const lastUpdated = document.getElementById("last-updated");
        const copyLogsButton = document.getElementById("copy-logs");
        const maskBox = document.getElementById("af-mask");
        const MASK = "*****";
        maskBox.checked = window.tbotHideData.get();
        const COORD_IN_TEXT = /\[?[A-Za-z]+:\d+:\d+:\d+\]?/g;
        function maskText(text) {
            return maskBox.checked ? String(text ?? "").replace(COORD_IN_TEXT, `[${MASK}]`) : String(text ?? "");
        }
        const instance = root.dataset.instance;
        const snapshotUrl = '@Url.Action("Snapshot", "AutoFarm")';
        let snapshot = @Html.Raw(initialSnapshot);
        let renderedSnapshotKey = "";
        let requestInProgress = false;
        const commandUrl = '@Url.Action("Command", "AutoFarm")';
        let activeTab = "overview";
        let activeGalaxy = "all";
        try { activeGalaxy = localStorage.getItem("af-galaxy") || "all"; } catch { }
        try { activeTab = localStorage.getItem("af-tab") || "overview"; } catch { }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function formatDate(value) {
            if (!value) return "Not available";
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? "Not available" : date.toLocaleString();
        }

        function formatNumber(value) {
            return Number(value || 0).toLocaleString();
        }

        function statusClass(value) {
            return String(value || "unknown").toLowerCase().replace(/[^a-z0-9]+/g, "-");
        }

        function emptyRow(columns, message) {
            return `<tr><td colspan="${columns}" class="empty-cell">${escapeHtml(message)}</td></tr>`;
        }

        function reasonHtml(label, detail) {
            return `<div class="reason"><span class="reason-label reason-${statusClass(label)}">${escapeHtml(label || "No reason recorded")}</span><span class="reason-detail">${escapeHtml(maskText(detail || ""))}</span></div>`;
        }

        function renderDeuteriumNotice(d) {
            if (!d || !d.available || !d.guardEnabled) return "";
            const low = (d.origins || []).filter(o => o.low);
            if (!low.length) return "";
            const list = low.map(o => `${escapeHtml(maskText(`[${o.coordinate}]`))} ${formatNumber(o.deuterium)}`).join(", ");
            if (d.override) {
                return `<div class="notice">Deuterium is below ${formatNumber(d.minDeuterium)} (${list}), but the guard is bridged manually (AutoFarm.DeuteriumGuardOverride).</div>`;
            }
            return `<div class="notice notice-warn"><strong>Deuterium too low for bigger fleets.</strong> Below ${formatNumber(d.minDeuterium)}: ${list}. Attacks on defended targets from there are paused${d.speedFleetBlocked ? " and the speed fleet is switched off" : ""}. To bridge this manually, set AutoFarm.DeuteriumGuardOverride in the config.</div>`;
        }

        function renderDeuterium(d) {
            if (!d || !d.available) {
                return `<section class="panel"><div class="panel-heading"><h2>Deuterium (start celestials)</h2></div><p class="empty-cell">Not available yet - AutoFarm writes the stock with its next cycle.</p></section>`;
            }
            const rows = (d.origins || []).map(o => `<tr><td>${escapeHtml(maskText(`[${o.coordinate}]`))}</td><td>${formatNumber(o.deuterium)}</td><td>${o.low ? (d.guardEnabled && !d.override ? "too low" : "low") : "ok"}</td></tr>`).join("") || emptyRow(3, "No start celestials.");
            const guard = !d.guardEnabled ? "Guard off" : (d.override ? "Bridged manually" : `Guard on, minimum ${formatNumber(d.minDeuterium)}`);
            return `<section class="panel">
                <div class="panel-heading"><h2>Deuterium (start celestials)</h2><span class="panel-count">${escapeHtml(guard)}</span></div>
                <div class="table-wrap"><table><thead><tr><th>Celestial</th><th>Deuterium</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div>
                <p class="reason-detail">Updated ${formatDate(d.updatedUtc)}</p>
            </section>`;
        }

        function renderWorker(worker, databaseAvailable) {
            return `<section class="panel">
                <div class="panel-heading"><h2>Worker status</h2><span class="status status-${statusClass(worker.state)}">${escapeHtml(worker.state)}</span></div>
                <dl class="facts-grid">
                    <div><dt>Last execution</dt><dd>${formatDate(worker.lastExecutionUtc)}</dd></div>
                    <div><dt>Last activity</dt><dd>${formatDate(worker.lastActivityUtc)}</dd></div>
                    <div><dt>Next execution</dt><dd>${escapeHtml(worker.nextExecutionText || "Not available")}</dd></div>
                    <div><dt>Database</dt><dd>${databaseAvailable ? "Available" : "Not available"}</dd></div>
                </dl>
            </section>`;
        }

        function renderSlots(slots) {
            const max = slots.maxSlots == null ? "Not available" : formatNumber(slots.maxSlots);
            const used = slots.usedSlots == null ? "Not available" : formatNumber(slots.usedSlots);
            const available = slots.availableSlots == null ? "Not available" : formatNumber(slots.availableSlots);
            return `<section class="panel">
                <div class="panel-heading"><h2>Fleet slots</h2><span class="panel-count">AutoFarm budget</span></div>
                <div class="metric-grid">
                    <div class="metric"><span>Used</span><strong>${used}</strong></div>
                    <div class="metric"><span>Available</span><strong>${available}</strong></div>
                    <div class="metric"><span>Maximum</span><strong>${max}</strong></div>
                    <div class="metric"><span>Probes observed</span><strong>${formatNumber(slots.probesInFlight)}</strong></div>
                    <div class="metric"><span>Attacks observed</span><strong>${formatNumber(slots.attacksInFlight)}</strong></div>
                </div>
                <p class="panel-note">Slot values come from the latest AutoFarm budget message. Probe and attack counts are observed in the current cycle.</p>
            </section>`;
        }

        function renderScan(scan) {
            const percent = Math.max(0, Math.min(100, Number(scan.progressPercent || 0)));
            const cursor = scan.cursorGalaxy > 0 ? `${scan.cursorGalaxy}:${scan.cursorSystem}` : "Not available";
            return `<section class="panel">
                <div class="panel-heading"><h2>Scan progress</h2><span class="panel-count">${formatNumber(percent)}%</span></div>
                <div class="progress-line"><progress max="100" value="${percent}"></progress><strong>${formatNumber(scan.scannedSystemsInRange)} / ${formatNumber(scan.totalSystemsInRange)} systems</strong></div>
                <dl class="facts-grid compact-facts">
                    <div><dt>Current cursor</dt><dd>${escapeHtml(cursor)}</dd></div>
                    <div><dt>Cached systems</dt><dd>${formatNumber(scan.cachedSystems)}</dd></div>
                    <div><dt>Cursor updated</dt><dd>${formatDate(scan.cursorUpdatedAtUtc)}</dd></div>
                    <div><dt>Last system observed</dt><dd>${formatDate(scan.lastSystemObservedAtUtc)}</dd></div>
                </dl>
            </section>`;
        }

        function coordParts(text) {
            const m = /(\d+):(\d+):(\d+)/.exec(String(text || ""));
            return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : [0, 0, 0];
        }

        function galaxyOf(text) {
            const m = /(\d+):\d+/.exec(String(text || ""));
            return m ? Number(m[1]) : 0;
        }

        function galaxyBar(items, getCoord) {
            const counts = new Map();
            items.forEach(item => { const g = galaxyOf(getCoord(item)); if (g) counts.set(g, (counts.get(g) || 0) + 1); });
            const galaxies = Array.from(counts.keys()).sort((a, b) => a - b);
            if (activeGalaxy !== "all" && !counts.has(Number(activeGalaxy))) activeGalaxy = "all";
            const btn = (value, label, count) => `<button type="button" class="galaxy-button${String(value) === String(activeGalaxy) ? " active" : ""}" data-galaxy="${value}">${label} <span class="tab-count">${count}</span></button>`;
            return `<nav class="galaxy-bar">${btn("all", "All", items.length)}${galaxies.map(g => btn(g, "Galaxy " + g, counts.get(g))).join("")}</nav>`;
        }

        function filterGalaxy(items, getCoord) {
            return activeGalaxy === "all" ? items : items.filter(item => galaxyOf(getCoord(item)) === Number(activeGalaxy));
        }

        function removeButton(cmd, coordinate) {
            const c = coordParts(coordinate);
            if (!c[0]) return "";
            return `<button type="button" class="plain-button af-cmd" data-cmd="${cmd}" data-coord="${c.join(":")}">Remove</button>`;
        }

        function renderTargets(reports) {
            const sorted = reports.map(report => ({ report, c: coordParts(report.coordinate) }))
                .sort((a, b) => a.c[0] - b.c[0] || a.c[1] - b.c[1] || a.c[2] - b.c[2])
                .map(item => item.report);
            const rows = sorted.length ? sorted.map(report => `<tr>
                <td><strong>${escapeHtml(report.targetName || "Unnamed target")}</strong><span class="coordinate">${escapeHtml(report.coordinate)}</span></td>
                <td><span class="status status-${statusClass(report.state)}">${escapeHtml(report.state)}</span><span class="coordinate">Report #${formatNumber(report.reportId)}</span></td>
                <td class="resources">${formatNumber(report.totalResources)}</td>
                <td>${reasonHtml(report.reason, report.reasonDetail)}</td>
                <td class="muted">${formatDate(report.updatedAtUtc)}</td>
                <td>${removeButton("removeTarget", report.coordinate)}</td>
            </tr>`).join("") : emptyRow(6, "No reports for this selection.");
            return `<section class="panel panel-primary">
                <div class="panel-heading"><h2>Targets and decisions</h2><span class="panel-count">${formatNumber(sorted.length)}</span></div>
                <p class="panel-note">Sorted by galaxy, system and position. The reason column explains why AutoFarm sent, postponed or ignored each target. Remove deletes the target (and its blacklist entry) at the next AutoFarm cycle.</p>
                <div class="table-wrap"><table><thead><tr><th>Target</th><th>State</th><th>Reported resources</th><th>Reason</th><th>Updated</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>`;
        }

        function renderMaintenance(data) {
            const list = data.blacklist || [];
            const rows = list.length ? list.map(b => `<tr>
                <td class="mono">${escapeHtml(b.coordinate)}</td>
                <td>${escapeHtml(b.reason)}</td>
                <td>${formatDate(b.blacklistedAtUtc)}</td>
                <td>${formatDate(b.expiresAtUtc)}</td>
                <td><button type="button" class="plain-button af-cmd" data-cmd="removeBlacklist" data-coord="${escapeHtml(b.coordinate)}">Remove</button></td>
            </tr>`).join("") : emptyRow(5, "The blacklist is empty.");
            const pending = data.pendingCommands > 0 ? `<div class="notice">${formatNumber(data.pendingCommands)} command(s) waiting - AutoFarm runs them at the start of its next cycle.</div>` : "";
            return `${pending}<section class="panel">
                <div class="panel-heading"><h2>Blacklist</h2><span class="panel-count">${formatNumber(list.length)}</span></div>
                <div class="table-wrap"><table><thead><tr><th>Target</th><th>Reason</th><th>Added</th><th>Expires</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>
            <section class="panel">
                <div class="panel-heading"><h2>Maintenance</h2></div>
                <p class="panel-note">Commands are handed to the AutoFarm worker and run at the start of its next cycle (the bot keeps these data in memory). The worker must be active.</p>
                <div class="maint-actions">
                    <button type="button" class="plain-button af-cmd" data-cmd="clearBlacklist">Clear blacklist</button>
                    <button type="button" class="plain-button af-cmd" data-cmd="clearSystems">Clear system cache and restart scan</button>
                    <button type="button" class="plain-button af-cmd danger" data-cmd="resetDb">Reset whole database</button>
                </div>
                <p class="panel-note">Reset whole database deletes scanned systems, targets, attack history, scan position and the loss/profit list, and clears the blacklist. This cannot be undone.</p>
            </section>`;
        }

        function renderSystems(systems) {
            const rows = systems.length ? systems.map(system => `<tr>
                <td class="mono">${escapeHtml(system.coordinate)}</td>
                <td><span class="status status-${statusClass(system.status)}">${escapeHtml(system.status)}</span></td>
                <td>${formatDate(system.lastScannedUtc)}</td>
                <td>${formatDate(system.nextRefreshUtc)}</td>
                <td>${escapeHtml(system.reason)}</td>
            </tr>`).join("") : emptyRow(5, "No cached systems are stored.");
            return `<section class="panel">
                <div class="panel-heading"><h2>Cached systems</h2><span class="panel-count">${formatNumber(systems.length)}</span></div>
                <div class="table-wrap"><table><thead><tr><th>System</th><th>Status</th><th>Last scan</th><th>Next refresh</th><th>Reason</th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>`;
        }

        function renderAttacks(attacks) {
            const rows = attacks.length ? attacks.map(attack => `<tr>
                <td>${formatDate(attack.dispatchedAtUtc)}</td>
                <td><strong>${maskBox.checked ? MASK : escapeHtml(attack.origin)}</strong><span class="coordinate">${escapeHtml(attack.mission)}</span></td>
                <td><strong>${escapeHtml(attack.targetName || "Unnamed target")}</strong><span class="coordinate">${escapeHtml(attack.coordinate)}</span></td>
                <td class="mono">#${formatNumber(attack.reportId)}</td>
                <td class="resources">${formatNumber(attack.totalResources)}</td>
            </tr>`).join("") : emptyRow(5, "No fleet dispatch has been recorded yet.");
            return `<section class="panel">
                <div class="panel-heading"><h2>Recorded attacks</h2><span class="panel-count">${formatNumber(attacks.length)}</span></div>
                <p class="panel-note">Only dispatches successfully recorded after a fleet was sent are shown here.</p>
                <div class="table-wrap"><table><thead><tr><th>When</th><th>Origin</th><th>Destination</th><th>Report</th><th>Reported resources</th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>`;
        }

        function res3(set, signed) {
            const one = (label, value) => `<span class="res3-line${signed ? (value >= 0 ? " net-positive" : " net-negative") : ""}"><i>${label}</i> ${formatNumber(value)}</span>`;
            const r = set || {};
            return `<div class="res3">${one("Met", r.metal || 0)}${one("Kris", r.crystal || 0)}${one("Deut", r.deuterium || 0)}</div>`;
        }

        function netTotal(set) {
            const r = set || {};
            const total = (r.metal || 0) + (r.crystal || 0) + (r.deuterium || 0);
            return `<div class="net-total res3-line ${total >= 0 ? "net-positive" : "net-negative"}"><i>Total</i> ${formatNumber(total)}</div>`;
        }

        function renderLosses(periods) {
            const list = periods || [];
            const rows = list.length ? list.map(p => {
                const ships = (p.ships || []).length ? p.ships.map(s => `${formatNumber(s.count)}&times; ${escapeHtml(s.ship)}`).join(", ") : "none";
                const share = p.plannedLoot > 0 ? `${Math.round(p.lossValue * 100 / p.plannedLoot)}%` : "-";
                const hasLoot = p.actualCount > 0;
                return `<tr>
                    <td><strong>${escapeHtml(p.label)}</strong><span class="coordinate">${formatNumber(p.attacks)} attacks${p.destroyed ? `, ${formatNumber(p.destroyed)} destroyed` : ""}${p.unknown ? `, ${formatNumber(p.unknown)} unknown` : ""}${p.pending ? `, ${formatNumber(p.pending)} open` : ""}</span></td>
                    <td>${ships}</td>
                    <td class="resources">${res3(p.lossRes)}<span class="coordinate">${share} of planned loot</span></td>
                    <td class="resources">${res3(p.plannedRes)}</td>
                    <td class="resources">${hasLoot ? res3(p.actualRes) : "-"}<span class="coordinate">${hasLoot ? formatNumber(p.actualCount) + " returns" : "not recorded yet"}</span></td>
                    <td class="resources">${formatNumber(p.fuel)}<span class="coordinate">Deut</span></td>
                    <td class="resources net-cell">${hasLoot ? res3(p.netRes, true) + netTotal(p.netRes) : "-"}</td>
                </tr>`;
            }).join("") : emptyRow(7, "No loss data yet.");
            return `<section class="panel">
                <div class="panel-heading"><h2>Losses and profit</h2></div>
                <p class="panel-note">Shown per resource (Met = metal, Kris = crystal, Deut = deuterium). Profit after losses and fuel = actual loot (cargo of the returning fleet) &minus; ship losses &minus; fuel (fuel is deuterium). Fleets that were not observed are marked unknown and not counted.</p>
                <div class="table-wrap"><table><thead><tr><th>Period</th><th>Ships lost</th><th>Ship losses</th><th>Planned loot</th><th>Actual loot</th><th>Fuel</th><th>Profit after losses and fuel</th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>`;
        }

        function renderErrors(errors) {
            const rows = errors.length ? errors.map(log => `<tr><td>${formatDate(log.dateTimeUtc)}</td><td>${escapeHtml(log.sender)}</td><td class="log-message">${escapeHtml(maskText(log.message))}</td></tr>`).join("") : emptyRow(3, "No recent AutoFarm errors or warnings.");
            return `<section class="panel">
                <div class="panel-heading"><h2>Recent errors</h2><button type="button" class="plain-button copy-errors" id="copy-errors">Copy errors</button></div>
                <div class="table-wrap"><table><thead><tr><th>When</th><th>Source</th><th>Message</th></tr></thead><tbody>${rows}</tbody></table></div>
            </section>`;
        }

        function renderLogs(logs) {
            const text = maskText(logs.map(log => log.copyText).join("\n"));
            return `<section class="panel">
                <details class="logs-details" id="autofarm-log-details">
                    <summary id="autofarm-log-summary">Recent AutoFarm logs (${formatNumber(logs.length)})</summary>
                    <pre>${escapeHtml(text || "No logs available.")}</pre>
                </details>
            </section>`;
        }

        function captureUiState() {
            const activeElement = document.activeElement;
            return {
                activeId: activeElement && activeElement.id ? activeElement.id : null,
                details: Array.from(content.querySelectorAll("details[id]")).map(details => ({ id: details.id, open: details.open })),
                scrollTop: window.scrollY
            };
        }

        function restoreUiState(state) {
            state.details.forEach(item => {
                const details = document.getElementById(item.id);
                if (details) details.open = item.open;
            });

            if (state.activeId) {
                const activeElement = document.getElementById(state.activeId);
                if (activeElement) activeElement.focus({ preventScroll: true });
            }

            window.scrollTo(0, state.scrollTop);
        }

        function render(data) {
            snapshot = data;
            const nextSnapshotKey = JSON.stringify(data) + "|" + maskBox.checked + "|" + activeGalaxy + "|" + activeTab;
            notice.innerHTML = renderDeuteriumNotice(data.deuterium) + (data.databaseAvailable ? "" : `<div class="notice">No AutoFarm database is available for this instance yet. The page will populate after AutoFarm has run once.</div>`);

            if (nextSnapshotKey === renderedSnapshotKey) return;

            const uiState = captureUiState();
            const tabs = [
                ["overview", "Overview", ""],
                ["targets", "Targets", formatNumber(data.reports.length)],
                ["attacks", "Attacks", formatNumber(data.attacks.length)],
                ["systems", "Systems", formatNumber(data.systems.length)],
                ["maintenance", "Blacklist & maintenance", formatNumber((data.blacklist || []).length)],
                ["logs", "Logs & errors", formatNumber(data.errors.length)]
            ];
            if (!tabs.some(t => t[0] === activeTab)) activeTab = "overview";
            const bar = `<nav class="tab-bar" role="tablist">${tabs.map(t => `<button type="button" role="tab" class="tab-button${t[0] === activeTab ? " active" : ""}" data-tab="${t[0]}">${escapeHtml(t[1])}${t[2] ? ` <span class="tab-count">${t[2]}</span>` : ""}</button>`).join("")}</nav>`;
            const panels = {
                overview: () => [renderWorker(data.worker, data.databaseAvailable), renderDeuterium(data.deuterium), renderSlots(data.slots), renderScan(data.scan), renderLosses(data.losses)].join(""),
                targets: () => galaxyBar(data.reports, r => r.coordinate) + renderTargets(filterGalaxy(data.reports, r => r.coordinate)),
                attacks: () => galaxyBar(data.attacks, a => a.coordinate) + renderAttacks(filterGalaxy(data.attacks, a => a.coordinate)),
                systems: () => galaxyBar(data.systems, x => x.coordinate) + renderSystems(filterGalaxy(data.systems, x => x.coordinate)),
                maintenance: () => galaxyBar(data.blacklist || [], b => b.coordinate) + renderMaintenance({ ...data, blacklist: filterGalaxy(data.blacklist || [], b => b.coordinate) }),
                logs: () => renderErrors(data.errors) + renderLogs(data.logs)
            };
            content.innerHTML = bar + panels[activeTab]();
            renderedSnapshotKey = nextSnapshotKey;
            restoreUiState(uiState);
        }

        async function copyText(text, button) {
            const original = button.textContent;
            if (!text) {
                button.textContent = "Nothing to copy";
                setTimeout(() => button.textContent = original, 1800);
                return;
            }
            try {
                await navigator.clipboard.writeText(text);
                button.textContent = "Copied";
                setTimeout(() => button.textContent = original, 1800);
            } catch {
                button.textContent = "Copy failed";
                setTimeout(() => button.textContent = original, 1800);
            }
        }

        document.addEventListener("click", async event => {
            const tab = event.target.closest(".tab-button");
            if (tab) {
                activeTab = tab.dataset.tab;
                try { localStorage.setItem("af-tab", activeTab); } catch { }
                renderedSnapshotKey = "";
                render(snapshot);
                return;
            }
            const galaxy = event.target.closest(".galaxy-button");
            if (galaxy) {
                activeGalaxy = galaxy.dataset.galaxy;
                try { localStorage.setItem("af-galaxy", activeGalaxy); } catch { }
                renderedSnapshotKey = "";
                render(snapshot);
                return;
            }
            const button = event.target.closest(".af-cmd");
            if (!button) return;
            const cmd = button.dataset.cmd;
            const coord = button.dataset.coord || "";
            const texts = {
                clearBlacklist: "Clear the whole blacklist?",
                removeBlacklist: `Remove ${coord} from the blacklist?`,
                removeTarget: `Remove target ${coord} (and its blacklist entry)?`,
                clearSystems: "Clear the system cache and restart the scan from the beginning?",
                resetDb: "Reset the whole AutoFarm database and the blacklist? This cannot be undone."
            };
            if (!window.confirm(texts[cmd] || "Run this command?")) return;
            if (cmd === "resetDb" && window.prompt('Type DELETE to confirm.') !== "DELETE") return;
            try {
                const body = new URLSearchParams({ instance, cmd, coord });
                const response = await fetch(commandUrl, { method: "POST", body });
                const result = await response.json();
                pollStatus.textContent = result.success ? "Command queued - AutoFarm runs it at its next cycle." : `Command failed: ${result.error}`;
                refresh();
            } catch (error) {
                pollStatus.textContent = `Command failed: ${error.message}`;
            }
        });

        copyLogsButton.addEventListener("click", () => copyText(maskText(snapshot.logs.map(log => log.copyText).join("\n")), copyLogsButton));
        document.addEventListener("click", event => {
            const button = event.target.closest(".copy-errors");
            if (!button) return;
            copyText(maskText(snapshot.errors.map(log => log.copyText).join("\n")), button);
        });

        async function refresh() {
            if (requestInProgress || document.hidden) return;
            requestInProgress = true;
            try {
                const response = await fetch(`${snapshotUrl}?instance=${encodeURIComponent(instance)}`, { cache: "no-store" });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                render(await response.json());
                pollStatus.textContent = "Live updates enabled";
                lastUpdated.textContent = `Last updated ${new Date().toLocaleTimeString()}`;
            } catch (error) {
                pollStatus.textContent = "Live update failed. The last known data is still shown.";
                lastUpdated.textContent = error.message;
            } finally {
                requestInProgress = false;
            }
        }

        maskBox.addEventListener("change", () => window.tbotHideData.set(maskBox.checked));
        maskBox.addEventListener("change", () => {
            render(snapshot);
        });

        render(snapshot);
        refresh();
        window.setInterval(refresh, 5000);
    })();
</script>
