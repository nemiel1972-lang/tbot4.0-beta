<!DOCTYPE html>
@{ var uiLang = Tbot.Common.Settings.UiLanguage.Read(); }
<html lang="@uiLang" data-lang="@uiLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#212529">
    <link rel="icon" type="image/jpg" href="~/favicon.ico">
    <link rel="manifest" href="~/manifest.json" asp-append-version="true"/>
    <!-- iOS support -->
    <link rel="apple-touch-icon" href="/img/TBot logo 72.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 96.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 128.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 144.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 152.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 192.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 384.png" />
    <link rel="apple-touch-icon" href="/img/TBot logo 512.png" />
    <meta name="apple-mobile-web-app-status-bar" content="#212529" />

    <title>T-Bot</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link id="tb-ui-css" rel="stylesheet" href="~/css/tbot-ui.css" asp-append-version="true" />
    <script>try { if (localStorage.getItem("tb.ui") === "classic") document.getElementById("tb-ui-css").disabled = true; } catch (e) { }</script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>window.tbotHideDefault = @(TBot.WebUI.Services.HideDataDefault.Get() ? "true" : "false");</script>
    <script>window.tbotNoAuction = @(TBot.WebUI.Services.BuildInfo.NoAuction ? "true" : "false");</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (uiLang != "en")
    {
        <script src="@Url.Action("LangScript", "Config", new { lang = uiLang })"></script>
    }
    <script src="~/js/i18n-ui.js" asp-append-version="true"></script>
    <script src="~/js/whatsnew.js" asp-append-version="true"></script>
    <script src="~/js/tbot-ui.js" asp-append-version="true" defer></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand ms-3 ms-md-0" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/img/tbot-logo.jpg" style="max-height:50px" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Config" asp-action="Index">Config</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Logging" asp-action="Index">Logging</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Ogame" asp-action="Index">Ogame</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="AutoFarm" asp-action="Index">AutoFarm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Autobuilds" asp-action="Index" data-also="/minenplan">Build planning</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Belohnungen" asp-action="Index">Rewards</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Logistik" asp-action="Index" data-also="/slots,/fleeter,/galaxy">Experimental</a>
                        </li>
                    </ul>
                    @if (!string.IsNullOrEmpty(TBot.Common.BuildInfo.Display))
                    {
                        <span class="text-secondary small me-3" title="Build (commit and build time)">Build @TBot.Common.BuildInfo.Display</span>
                    }
                    <select id="ui-langsel" class="form-select form-select-sm w-auto me-2" title="Language" data-setlang="@Url.Action("SetLanguage", "Config")">
                        @foreach (var l in Tbot.Common.Settings.UiLanguage.Available())
                        {
                            <option value="@l.Code" selected="@(uiLang == l.Code)">@l.Name</option>
                        }
                    </select>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid main-container">
        <div id="backdrop">
            <div class="text-center loading">
                <div class="spinner-border" role="status">
                </div>
            </div>
        </div>
        @if (TBot.WebUI.Services.LegacyConfigCheck.IsLegacy())
        {
            <div style="background:#b3261e;color:#fff;padding:10px 16px;margin:0 0 8px;font-weight:600">
                Old config detected - only the Defender is running. Stop the bot, run MigrateConfig (main folder), check the config and restart.
                Already migrated by hand? Add "ConfigVersion": 4 at the top of instance_settings.json.
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    @await RenderSectionAsync("Scripts", required: false)

    <script type="text/javascript">
        (function () {
            var s = document.getElementById("ui-langsel");
            if (!s) return;
            s.addEventListener("change", function () {
                fetch(s.dataset.setlang, { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: "lang=" + encodeURIComponent(s.value) })
                    .then(function (r) { return r.json(); })
                    .then(function (j) { if (j && j.success) location.reload(); else alert("Language not saved: " + ((j && j.error) || "settings.json not found")); })
                    .catch(function (e) { alert("Language not saved: " + e); });
            });
        })();
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", function () {
                navigator.serviceWorker
                    .register("/serviceWorker.js")
                    .then(res => console.log("service worker registered"))
                    .catch(err => console.log("service worker not registered", err))
            })
        }
    </script>
</body>
</html>
