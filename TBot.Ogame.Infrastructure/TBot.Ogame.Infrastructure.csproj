<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Alte Null-Warnungen der Modelle (JSON-Deserialisierung) und Stilregeln (Async-Suffix) bewusst ausgeblendet -->
    <NoWarn>NETSDK1188;$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;VSTHRD200;VSTHRD002;CS8625;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.6.3" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TBot.Common\TBot.Common.csproj" />
  </ItemGroup>

</Project>
