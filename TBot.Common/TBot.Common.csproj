<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>$(NoWarn);NETSDK1188;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8625;CS8765;VSTHRD200;VSTHRD103;VSTHRD012</NoWarn>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.14.15" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.AspNetCore.SignalR" Version="0.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Telegram.Alternative" Version="1.5.0" />
  </ItemGroup>

  <!-- Build-Info fuer die WebUI: Zeitpunkt des Builds und kurzer Git-Commit als Assembly-Metadaten (ohne Git: nur die Zeit) -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <Target Name="TBotGitCommit" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="TBotGitOut" />
    </Exec>
    <PropertyGroup>
      <TBotGitHash Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(TBotGitOut)', '^[0-9a-f]{7,12}$'))">$(TBotGitOut)</TBotGitHash>
    </PropertyGroup>
    <ItemGroup Condition="'$(TBotGitHash)' != ''">
      <AssemblyMetadata Include="GitCommit" Value="$(TBotGitHash)" />
    </ItemGroup>
  </Target>

</Project>
